<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      * {
        margin: 0;
        padding: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        scroll-behavior: smooth;
        box-sizing: border-box;
      }
      nav {
        display: flex;
        align-items: center;
        justify-content: space-around;
        position: sticky;
        top: 0;
        min-height: 60px;
        background: #bdbbbb;
        backdrop-filter: blur(10px);
        z-index: 1000;
      }
      .logo {
        font-size: 30px;
        font-weight: 800;
        color: #000;
        font-family: "Cascadia Code";
      }
      @media (max-width: 400px) {
        .logo {
          font-size: 20px;
        }
      }
      #hamburger {
        height: 25px;
        width: 25px;
        display: none;
        background: none;
        border: none;
        cursor: pointer;
      }
      .hamburger_line {
        background-color: Black;
        height: 4px;
        width: 100%;
      }
      @media (max-width: 700px) {
        #hamburger {
          display: flex;
          align-items: center;
          justify-content: space-between;
          flex-direction: column;
        }
      }
      .nav-menu {
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-around;
        height: 100%;
      }
      .nav-menu li {
        padding: 10px;
        height: 100%;
        align-content: center;
        display: flex;
      }
      .nav-menu li a {
        text-decoration: none;
        color: #000;
        font-weight: bold;
        position: relative;
      }
      .nav-menu li a:hover {
        background: #646363;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        transition: 300ms;
      }
      .nav-menu li a::after {
        content: "";
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 2px;
        background: #646363;
        transition: width 0.3s ease;
        -webkit-transition: width 0.3s ease;
        -moz-transition: width 0.3s ease;
        -ms-transition: width 0.3s ease;
        -o-transition: width 0.3s ease;
      }

      .nav-menu li a:hover::after {
        width: 100%;
      }
      @media (max-width: 700px) {
        .nav-menu {
          position: absolute;
          top: 60px;
          flex-direction: column;
          transform: translate(-100%);
          transition: 0.3s;
        }
        .nav-menu li {
          background: #a8a6a6;
          width: 100vw;
        }
        .nav-menu li a {
          width: 100vw;
          text-align: center;
        }
      }
      .active {
        transform: translate(0%);
      }
      .blog-content {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 10px 0 60px;
        font-size: 17px;
        line-height: 1.85;

        word-wrap: break-word;
        overflow-wrap: break-word;
      }
      .blog-content p {
        margin: 0 0 22px;
      }
      .blog-content h2 {
        margin: 45px 0 18px;

        color: #10008a;

        font-size: 30px;
        line-height: 1.3;
        font-weight: 700;

        letter-spacing: -0.5px;

        padding-bottom: 10px;

        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .blog-content h3 {
        margin: 32px 0 14px;

        color: #0b77e3;

        font-size: 23px;
        line-height: 1.4;
        font-weight: 650;
      }

      .blog-content a {
        text-decoration: none;

        border-bottom: 1px dashed rgba(96, 165, 250, 0.5);

        transition:
          color 0.2s ease,
          border-color 0.2s ease;
      }
      .blog-content a:hover {
        color: #93c5fd;

        border-bottom-color: #93c5fd;
      }
      .blog-content strong {
        color: #005a72;
        font-weight: 700;
      }

      .blog-content em {
        color: #e2e8f0;
      }
      .blog-content ul,
      .blog-content ol {
        margin: 0 0 25px;

        padding-left: 30px;
      }

      .blog-content li {
        margin-bottom: 10px;

        padding-left: 5px;
      }

      .blog-content li::marker {
        color: #60a5fa;
        font-weight: 700;
      }
      .blog-content code {
        font-family:
          "Cascadia Code", "Fira Code", "JetBrains Mono", Consolas, monospace;

        font-size: 0.9em;

        color: red;

        background: rgba(255, 255, 255, 0.07);

        border: 1px solid rgba(255, 255, 255, 0.08);

        border-radius: 6px;

        padding: 3px 7px;
      }
      .blog-content pre {
        margin: 28px 0;

        padding: 22px;

        overflow-x: auto;

        background: #0b0f14;

        border: 1px solid rgba(255, 255, 255, 0.09);

        border-radius: 12px;

        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);

        scrollbar-width: thin;
      }

      .blog-content pre code {
        display: block;

        padding: 0;

        border: none;
        border-radius: 0;

        background: transparent;

        color: #ebe5e5;

        font-size: 14px;
        line-height: 1.75;

        white-space: pre;

        tab-size: 2;
      }
      .blog-content blockquote {
        position: relative;

        margin: 30px 0;

        padding: 20px 24px 20px 28px;

        background: rgba(96, 165, 250, 0.06);

        border-left: 4px solid #60a5fa;

        border-radius: 0 10px 10px 0;

        font-style: italic;
      }
      .blog-note,
      .blog-tip,
      .blog-warning {
        margin: 28px 0;

        padding: 18px 20px;

        border-radius: 10px;

        line-height: 1.7;
      }

      .blog-note {
        background: rgba(59, 130, 246, 0.08);

        border: 1px solid rgba(59, 130, 246, 0.2);
      }

      .blog-tip {
        background: rgba(34, 197, 94, 0.08);

        border: 1px solid rgba(34, 197, 94, 0.2);
      }

      .blog-warning {
        background: rgba(245, 158, 11, 0.08);

        border: 1px solid rgba(245, 158, 11, 0.2);
      }
      .table-wrapper {
        width: 100%;

        margin: 30px 0;

        overflow-x: auto;

        border-radius: 12px;

        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .blog-content table {
        width: 100%;

        border-collapse: collapse;

        min-width: 600px;

        background: rgba(255, 255, 255, 0.02);
      }

      .blog-content th,
      .blog-content td {
        padding: 14px 16px;

        text-align: left;

        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .blog-content th {
        color: #ffffff;

        font-weight: 700;

        background: rgba(255, 255, 255, 0.06);
      }

      .blog-content td {
        color: #cbd5e1;
      }

      .blog-content tr:last-child td {
        border-bottom: none;
      }
      .blog-content img {
        display: block;

        width: auto;

        max-width: 100%;

        height: auto;

        margin: 30px auto;

        border-radius: 14px;

        border: 1px solid rgba(255, 255, 255, 0.08);

        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
      }

      .blog-content figure {
        margin: 32px 0;

        text-align: center;
      }

      .blog-content figcaption {
        margin-top: 10px;

        color: #94a3b8;

        font-size: 14px;
      }
      .blog-content hr {
        margin: 40px 0;

        border: none;

        height: 1px;

        background: rgba(255, 255, 255, 0.1);
      }
      @media (max-width: 768px) {
        .blog-content {
          font-size: 16px;

          line-height: 1.75;

          padding-left: 5px;
          padding-right: 5px;
        }

        .blog-content h2 {
          margin-top: 38px;

          font-size: 25px;
        }

        .blog-content h3 {
          font-size: 21px;
        }

        .blog-content pre {
          padding: 16px;

          border-radius: 9px;

          font-size: 13px;
        }

        .blog-content blockquote {
          padding: 16px 18px;
        }

        .blog-content ul,
        .blog-content ol {
          padding-left: 25px;
        }
      }
      @media (max-width: 480px) {
        .blog-content {
          font-size: 15px;
        }

        .blog-content h2 {
          font-size: 23px;
        }

        .blog-content h3 {
          font-size: 19px;
        }

        .blog-content pre {
          margin-left: -5px;
          margin-right: -5px;

          border-radius: 8px;
        }

        .blog-note,
        .blog-tip,
        .blog-warning {
          padding: 15px;
        }
      }
      main {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
      }
      header {
        width: 100%;
        height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Cascadia Code";
        color: #ffffff;
        background: url(0002.jpg);
        background-size: max(100%, 650px);
      }
      footer {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 50px;
        background-color: #bdbbbb;
        width: 100%;
      }
    </style>
    <title>ICanCode | Best Blog for Developers</title>
  </head>
  <body>
    <nav class="navbar">
      <div class="logo">ICanCode</div>
      <ul id="nav-menu" class="nav-menu">
        <li><a href="/">Home</a></li>
        <li><a id="aboutlink" href="/about">About</a></li>
        <li><a href="https://hassanbinzubair.github.io">Portfolio</a></li>
      </ul>
      <div id="hamburger">
        <span class="hamburger_line"></span>
        <span class="hamburger_line"></span>
        <span class="hamburger_line"></span>
      </div>
    </nav>

    <main>
      {{{body}}}
    </main>
    <footer>
      <span>
        Created with ❤️ &amp; ☕
        <span id="datespan"></span></span></footer>
    <script>
      const hamburger = document.getElementById("hamburger"); const menu =
      document.getElementById("nav-menu"); const main =
      document.querySelector("main"); hamburger.addEventListener("click", () =>{
      menu.classList.toggle("active"); }); main.addEventListener("click", ()=>{
      menu.classList.remove("active"); });
      document.getElementById("datespan").innerHTML = new Date().getFullYear();
    </script>
  </body>
</html>